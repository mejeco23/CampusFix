{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm --prefix frontend run dev -- --host 127.0.0.1",
        "dev:api": "php backend/artisan serve --host 127.0.0.1 --port 8000",
        "dev:all": "concurrently \"npm --prefix frontend run dev -- --host 127.0.0.1\" \"php backend/artisan serve --host 127.0.0.1 --port 8000\"",
        "build": "npm --prefix frontend run build",
        "test": "composer --working-dir=backend test"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    }
}
